# Backend
SECRET_KEY=your-secret-key-change-in-production
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_NAME=System Administrator
DATABASE_URL=sqlite:///./data/app.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Drive
GOOGLE_DRIVE_CREDENTIALS_PATH=./credentials/service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-root-folder-id

# Google Geocoding
GOOGLE_GEOCODING_API_KEY=your-geocoding-api-key
# Enable Google Routes API for motorcycle road-distance sorting.
GOOGLE_ROUTES_API_KEY=your-routes-api-key

# Location Cache
LOCATION_CACHE_DISTANCE_THRESHOLD_METERS=50
LOCATION_CACHE_STALENESS_DAYS=365

# Admin Panel
VITE_API_BASE_URL=http://localhost:8000/api

# Mobile
API_BASE_URL=http://localhost:8000/api

# Shared Vite API path; development servers proxy this to the backend.
VITE_API_BASE_URL=/api
