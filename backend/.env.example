[TEMPLATE]
SECRET_KEY=change-this-in-development

# Initial Admin Credentials (change these for production deployment)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=your-secure-admin-password
ADMIN_NAME=System Administrator

DATABASE_URL=sqlite:///./data/app.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006
DEBUG=false

# Google Drive
GOOGLE_DRIVE_CREDENTIALS_PATH=../credentials/credentials.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=PASTE_YOUR_DRIVE_FOLDER_ID

# Google Geocoding
GOOGLE_GEOCODING_API_KEY=PASTE_YOUR_GEOCODING_API_KEY
# Enable Routes API for TWO_WHEELER route sorting. Falls back to the geocoding key if empty.
GOOGLE_ROUTES_API_KEY=

# Route sorting cost controls
# Travel mode: TWO_WHEELER (Enterprise SKU, ~Rs 0.40/element) or DRIVE (Essentials
# SKU, ~3x cheaper). TWO_WHEELER models two-wheel traffic; DRIVE does not.
ROUTE_TRAVEL_MODE=TWO_WHEELER
# Minutes an identical route plan is served from cache before re-billing Google.
ROUTE_PLAN_CACHE_MINUTES=30
