{
  "name": "Kuri - Field App",
  "short_name": "Kuri",
  "description": "Geotagged site inspection and field audit camera app with real-time GPS synchronization",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f8fafc",
  "theme_color": "#ffffff",
  "categories": ["productivity", "business", "utilities"],
  "icons": [
    {
      "src": "/app/brand-logo.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/brand-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/app/brand-logo.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Camera",
      "short_name": "Camera",
      "description": "Take new field inspection photos",
      "url": "/#camera",
      "icons": [
        {
          "src": "/app/brand-logo.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Assigned Tasks",
      "short_name": "Tasks",
      "description": "View pending field audit tasks",
      "url": "/#records",
      "icons": [
        {
          "src": "/app/brand-logo.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
